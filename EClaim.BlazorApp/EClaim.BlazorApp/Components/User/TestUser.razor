@page "/user-search-test"
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer
<h3>User Search Test</h3>

<EditForm Model="@searchModel" OnValidSubmit="SearchUsers" FormName="user-search-test">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText @bind-Value="searchModel.FullName" class="form-control" placeholder="Full Name" />
    <InputText @bind-Value="searchModel.Email" class="form-control mt-2" placeholder="Email" />
    <InputText @bind-Value="searchModel.Phone" class="form-control mt-2" placeholder="Phone" />

    <button type="submit" class="btn btn-primary mt-3">Search</button>
</EditForm>

<p class="mt-3">You typed: @typedInfo</p>

@code {
    private SearchModel searchModel = new();
    private string typedInfo = string.Empty;

    private void SearchUsers()
    {
        typedInfo = $"FullName: {searchModel.FullName}, Email: {searchModel.Email}, Phone: {searchModel.Phone}";
    }

    public class SearchModel
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
    }
}
