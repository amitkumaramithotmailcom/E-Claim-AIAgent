@using EClaim.BlazorApp.Models.ViewModel
@if (UserList != null)
{
    <h4 class="mt-4">Search Results</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Email Verified</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in UserList)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@user.Role</td>
                    <td>@user.IsEmailVerified</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    [Parameter]
    public IEnumerable<UsersViewModel>? UserList { get; set; }
}